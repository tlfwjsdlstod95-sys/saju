# AI 심층 풀이(선배 톤 LLM 해석)를 쓰려면 Anthropic API 키가 필요합니다.
# 1) https://console.anthropic.com 에서 키 발급
# 2) 이 파일을 복사해 .env.local 로 만들고 키를 채워주세요.
# (키가 없어도 규칙 기반 기본 풀이는 그대로 동작합니다.)

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# (선택) 사용할 모델. 기본값 claude-sonnet-4-6
# SAJU_MODEL=claude-sonnet-4-6

# ── 토스페이먼츠 결제 ──
# 테스트 키(공개 문서 키)로 바로 결제 흐름을 테스트할 수 있습니다.
# 운영 전환 시 https://docs.tosspayments.com 에서 본인 가맹점 키로 교체하세요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# ── (선택) 배포 도메인 ──
# 카톡·SNS 공유 미리보기(OG) 이미지가 올바른 절대주소로 나오도록, 배포 시 실제 도메인을 넣으세요.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ════════════════════════════════════════════════════════════
# 로그인 + 보관함 클라우드 저장 (선택 — 안 넣으면 익명 localStorage로만 동작)
# 자세한 발급 방법: 헤아림_로그인_셋업가이드.md
# ════════════════════════════════════════════════════════════

# Auth.js 공통 (필수). 아무 랜덤 문자열. 터미널: openssl rand -base64 32
AUTH_SECRET=

# 배포 후 실제 주소. 로컬은 http://localhost:3000
# AUTH_URL=https://your-domain.com

# 카카오 로그인 (developers.kakao.com → 내 앱 → REST API 키 / 보안 클라이언트 시크릿)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# 네이버 로그인 (developers.naver.com → 애플리케이션 등록)
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# 구글 로그인 (console.cloud.google.com → OAuth 2.0 클라이언트 ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase (supabase.com → 프로젝트 → Settings → API)
# SUPABASE_SERVICE_ROLE_KEY는 절대 공개 금지(서버 전용). NEXT_PUBLIC_ 붙이지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── (심사 기간 한정) PG·카드사 심사 전용 로그인 ──
# 판매 단위를 '리포트 1건'으로 바꾸며 결제 전 로그인이 필수가 됐다. 우리 로그인은 소셜 뿐이라
# 심사자에게 넘길 아이디/비밀번호가 없어서, 심사 기간에만 여는 전용 계정을 둔다.
# ⚠️ 둘 다 있을 때만 /review-login 이 열린다. 심사가 끝나면 두 변수를 지우고 재배포할 것.
# ⚠️ 이 계정에는 이용권을 주지 않는다(실제 결제 플로우를 그대로 밟아야 심사 의미가 있다).
#    SAJU_OWNER_UIDS 에 절대 추가하지 말 것.
# REVIEW_LOGIN_ID=toss-review
# REVIEW_LOGIN_PASSWORD=
